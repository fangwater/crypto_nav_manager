[Unit]
Description=Crypto Operations Monitor API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/crypto_nav_manager
ExecStart=/home/ubuntu/crypto_nav_manager/target/release/ops_monitor
Environment=CRYPTO_OPS_CONFIG=/home/ubuntu/crypto_nav_manager/config/ops-monitor.json
Environment=CRYPTO_OPS_BIND=127.0.0.1:4210
Environment=RUST_LOG=crypto_nav_manager::ops_monitor=info,tower_http=info
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
